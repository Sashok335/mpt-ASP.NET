@model IEnumerable<Practos3.Models.AdminCartItem>
@{
    ViewData["Title"] = "Элементы корзины";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Таблица элементов корзины WebShopDB</span>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4">Создать</a>
    </div>
    <div class="p-0">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Корзина</th>
                    <th>Товар</th>
                    <th>Количество</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CartItemID</td>
                        <td>@item.CartID</td>
                        <td>@item.Product?.ProductName</td>
                        <td>@item.Quantity</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.CartItemID" class="btn btn-sm btn-outline-info rounded-pill me-1">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.CartItemID" class="btn btn-sm btn-outline-danger rounded-pill">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
