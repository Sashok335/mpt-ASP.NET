@model Practos3.Models.AdminUser
@{
    ViewData["Title"] = "Удалить пользователя";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="danger-card">
    <h3 class="mb-3">Удалить пользователя?</h3>
    <p class="text-muted">Если у пользователя есть корзины или заказы, удаление будет заблокировано.</p>
    <div class="admin-card p-3 text-start my-4">
        <div><strong>ID:</strong> @Model.UserID</div>
        <div><strong>Логин:</strong> @Model.Login</div>
        <div><strong>Роль:</strong> @Model.Role?.RoleName</div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="UserID" />
        <div class="btn-toolbar-simple justify-content-center">
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
