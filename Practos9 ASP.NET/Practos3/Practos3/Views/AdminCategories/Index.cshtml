@model IEnumerable<Practos3.Models.AdminCategory>
@{
    ViewData["Title"] = "Категории";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Таблица категорий WebShopDB</span>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4">Создать</a>
    </div>
    <div class="p-0">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Товаров</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CategoryID</td>
                        <td>@item.CategoryName</td>
                        <td>@item.Products.Count</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.CategoryID" class="btn btn-sm btn-outline-info rounded-pill me-1">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryID" class="btn btn-sm btn-outline-danger rounded-pill">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
