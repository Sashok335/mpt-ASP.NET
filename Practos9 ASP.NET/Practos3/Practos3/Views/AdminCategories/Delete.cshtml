@model Practos3.Models.AdminCategory
@{
    ViewData["Title"] = "Удалить категорию";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="danger-card">
    <h3 class="mb-3">Удалить категорию?</h3>
    <p class="text-muted">Если в категории есть товары, удаление будет заблокировано.</p>
    <div class="admin-card p-3 text-start my-4">
        <div><strong>ID:</strong> @Model.CategoryID</div>
        <div><strong>Название:</strong> @Model.CategoryName</div>
        <div><strong>Товаров:</strong> @Model.Products.Count</div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="CategoryID" />
        <div class="btn-toolbar-simple justify-content-center">
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
