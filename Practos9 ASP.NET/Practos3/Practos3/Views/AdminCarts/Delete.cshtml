@model Practos3.Models.AdminCart
@{
    ViewData["Title"] = "Удалить корзину";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="danger-card">
    <h3 class="mb-3">Удалить корзину?</h3>
    <p class="text-muted">Связанные элементы корзины будут удалены.</p>
    <div class="admin-card p-3 text-start my-4">
        <div><strong>ID:</strong> @Model.CartID</div>
        <div><strong>Пользователь:</strong> @Model.User?.Login</div>
        <div><strong>Элементов:</strong> @Model.CartItems.Count</div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="CartID" />
        <div class="btn-toolbar-simple justify-content-center">
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
