using System.ComponentModel.DataAnnotations;
using System.Text.RegularExpressions;

namespace Practos3.Validation;

public class ProductNameMeaningfulStructureAttribute : ValidationAttribute
{
    protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
    {
        var text = value as string;
        if (string.IsNullOrWhiteSpace(text))
        {
            return ValidationResult.Success;
        }

        if (text.Contains("  "))
        {
            return new ValidationResult("Название не должно содержать двойные пробелы.");
        }

        var tokens = Regex.Split(text.Trim(), @"\s+")
            .Where(token => !string.IsNullOrWhiteSpace(token))
            .ToList();

        var meaningfulTokens = tokens.Count(token => Regex.IsMatch(token, "[A-Za-zА-Яа-я]"));
        var longestTokenLength = tokens.Max(token => token.Length);

        if (meaningfulTokens < 2 && longestTokenLength < 6)
        {
            return new ValidationResult("Название должно быть более осмысленным: минимум 2 слова или одно длинное слово.");
        }

        return ValidationResult.Success;
    }
}
