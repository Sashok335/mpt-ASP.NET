using System.ComponentModel.DataAnnotations;
using System.Text.RegularExpressions;

namespace Practos3.Validation;

public class ProductNameHasLettersAttribute : ValidationAttribute
{
    protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
    {
        var text = value as string;
        if (string.IsNullOrWhiteSpace(text))
        {
            return ValidationResult.Success;
        }

        var lettersCount = Regex.Matches(text, "[A-Za-zА-Яа-я]").Count;
        if (lettersCount < 3)
        {
            return new ValidationResult("Название должно содержать минимум 3 буквы.");
        }

        return ValidationResult.Success;
    }
}
