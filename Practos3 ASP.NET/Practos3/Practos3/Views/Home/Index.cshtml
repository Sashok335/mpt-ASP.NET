@model IEnumerable<Practos3.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="text-center mb-4 mt-4">
    <h1 class="display-5 fw-bold text-white">Каталог товаров</h1>

    <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
        <a asp-action="Index" asp-route-categoryId=""
           class="btn @(ViewBag.CurrentCategory == null ? "btn-info" : "btn-outline-info") rounded-pill px-4 fw-bold">
            Все
        </a>
        @foreach (var cat in ViewBag.Categories)
        {
            <a asp-action="Index" asp-route-categoryId="@cat.Id"
               class="btn @(ViewBag.CurrentCategory == cat.Id ? "btn-info" : "btn-outline-info") rounded-pill px-4 fw-bold">
                @cat.Name
            </a>
        }
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-lg text-white" style="background-color: #27344b; border-radius: 15px;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <span class="badge rounded-pill px-3 py-2"
                              style="background-color: rgba(255, 255, 255, 0.1);
                 border: 1px solid rgba(255, 255, 255, 0.2);
                 color: #e0e1dd;
                 font-weight: 500;
                 font-size: 0.8rem;">
                            @item.Category?.Name
                        </span>
                    </div>
                    <p class="card-text text-light opacity-75 small">@item.Description</p>
                </div>
                <div class="card-footer bg-transparent border-top border-secondary d-flex justify-content-between align-items-center py-3">
                    <span class="fs-4 fw-bold text-info">@item.Price.ToString("N0") ₽</span>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="m-0">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn btn-info px-3 shadow-sm text-dark fw-bold rounded-pill">
                            <i class="bi bi-plus-lg"></i> В корзину
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
<style>
    .transition-hover {
        transition: all 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: scale(1.05);
        }
</style>