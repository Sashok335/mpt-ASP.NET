@model Practos3.Models.AdminRole
@{
    ViewData["Title"] = "Удалить роль";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="danger-card">
    <h3 class="mb-3">Удалить роль?</h3>
    <p class="text-muted">Если роль назначена пользователям, удаление будет заблокировано.</p>
    <div class="admin-card p-3 text-start my-4">
        <div><strong>ID:</strong> @Model.RoleID</div>
        <div><strong>Название:</strong> @Model.RoleName</div>
        <div><strong>Пользователей:</strong> @Model.Users.Count</div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="RoleID" />
        <div class="btn-toolbar-simple justify-content-center">
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
