@model Practos3.Models.AdminProduct
@{
    ViewData["Title"] = "Удалить товар";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="danger-card">
    <h3 class="mb-3">Удалить товар?</h3>
    <p class="text-muted">Связанные элементы корзины и заказов будут тоже удалены.</p>
    <div class="admin-card p-3 text-start my-4">
        <div><strong>ID:</strong> @Model.ProductID</div>
        <div><strong>Название:</strong> @Model.ProductName</div>
        <div><strong>Цена:</strong> @Model.Price.ToString("0.00")</div>
        <div><strong>Категория:</strong> @Model.Category?.CategoryName</div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductID" />
        <div class="btn-toolbar-simple justify-content-center">
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>
