@model Practos3.Models.AdminUser
@{
    ViewData["Title"] = "Изменить пользователя";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="UserID" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Login" class="form-label">Логин</label>
            <input asp-for="Login" class="form-control" />
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PasswordHash" class="form-label">Пароль</label>
            <input asp-for="PasswordHash" class="form-control" />
            <span asp-validation-for="PasswordHash" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="RoleID" class="form-label">Роль</label>
            <select asp-for="RoleID" asp-items="ViewBag.Roles" class="form-select"></select>
            <span asp-validation-for="RoleID" class="text-danger"></span>
        </div>
        <div class="btn-toolbar-simple">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
