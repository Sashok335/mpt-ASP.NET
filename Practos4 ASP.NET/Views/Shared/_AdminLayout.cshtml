<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Панель администратора</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
            background-color: #1b263b;
            color: #e0e1dd;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', sans-serif;
        }
        .admin-topbar {
            background-color: #0d1b2a !important;
            border-bottom: 2px solid #415a77;
            position: sticky; top: 0; z-index: 100;
        }
        .admin-wrapper { display: flex; flex: 1; min-height: 0; }
        .admin-sidebar {
            background-color: #0d1b2a;
            width: 240px;
            flex-shrink: 0;
            border-right: 2px solid #415a77;
            padding: 16px 0;
            position: sticky;
            top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto;
        }
        .sidebar-section {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            color: #415a77;
            padding: 12px 20px 4px;
            font-weight: 700;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 18px;
            margin: 2px 10px;
            border-radius: 8px;
            color: #adb5bd;
            text-decoration: none;
            font-size: 0.92rem;
            transition: background 0.2s, color 0.2s;
        }
        .sidebar-link:hover, .sidebar-link.active {
            background-color: rgba(0,180,216,0.12);
            color: #00b4d8;
        }
        .sidebar-link i { font-size: 1rem; width: 20px; text-align: center; }
        .admin-content {
            flex: 1;
            padding: 28px 36px;
            overflow-x: auto;
            background-color: #1b263b;
        }
        .admin-table { color: #e0e1dd; border-collapse: separate; border-spacing: 0; }
        .admin-table thead th {
            background-color: #0d1b2a;
            color: #00b4d8;
            border-bottom: 2px solid #415a77 !important;
            border-top: none !important;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 12px 16px;
        }
        .admin-table tbody td {
            border-color: #27344b !important;
            padding: 12px 16px;
            vertical-align: middle;
        }
        .admin-table tbody tr { background-color: #1b263b; }
        .admin-table tbody tr:hover { background-color: #27344b; }
        .admin-card, .table-card, .form-card {
            background-color: #27344b;
            border: 1px solid #415a77;
            border-radius: 14px;
        }
        .admin-card-header {
            background-color: #0d1b2a;
            border-bottom: 1px solid #415a77;
            border-radius: 14px 14px 0 0 !important;
            padding: 14px 20px;
        }
        .form-card {
            padding: 24px;
            max-width: 760px;
        }
        .table-card .table { margin-bottom: 0; }
        .form-control, .form-select, textarea.form-control {
            background-color: #0d1b2a;
            border: 1px solid #415a77;
            color: #e0e1dd;
            border-radius: 8px;
        }
        .form-control:focus, .form-select:focus {
            background-color: #0d1b2a;
            border-color: #00b4d8;
            color: #e0e1dd;
            box-shadow: 0 0 0 3px rgba(0,180,216,0.2);
        }
        .form-control::placeholder { color: #6c757d; }
        .form-label { color: #adb5bd; font-size: 0.88rem; font-weight: 600; margin-bottom: 5px; }
        .btn-info, .btn-primary {
            background-color: #00b4d8;
            border: none;
            color: #0d1b2a;
            font-weight: 600;
        }
        .btn-info:hover, .btn-primary:hover { background-color: #00caf0; color: #0d1b2a; }
        .btn-outline-info, .btn-outline-primary {
            border-color: #00b4d8;
            color: #00b4d8;
            font-weight: 600;
        }
        .btn-outline-info:hover, .btn-outline-primary:hover { background-color: #00b4d8; color: #0d1b2a; }
        .btn-success {
            background-color: #2a9d8f;
            border: none;
            font-weight: 600;
        }
        .btn-success:hover { background-color: #33b3a3; }
        .btn-danger { background-color: #dc3545; border: none; font-weight: 600; }
        .btn-secondary, .btn-outline-secondary {
            background-color: #415a77;
            border-color: #415a77;
            color: #e0e1dd;
            font-weight: 600;
        }
        .btn-outline-secondary:hover, .btn-secondary:hover {
            background-color: #506b89;
            border-color: #506b89;
            color: #fff;
        }
        .btn-outline-danger { font-weight: 600; }
        .badge-info { background-color: rgba(0,180,216,0.15); color: #00b4d8; border: 1px solid rgba(0,180,216,0.3); }
        .alert-success {
            background-color: rgba(0,180,216,0.12);
            border: 1px solid #00b4d8;
            color: #e0e1dd;
        }
        .alert-danger {
            background-color: rgba(220,53,69,0.12);
            border: 1px solid #dc3545;
            color: #e0e1dd;
        }
        .page-title { font-size: 1.6rem; font-weight: 700; color: #fff; }
        .page-subtitle { color: #adb5bd; font-size: 0.9rem; }
        .danger-card, .delete-confirm-box {
            background-color: #27344b;
            border: 1px solid #415a77;
            border-radius: 14px;
            padding: 32px;
            max-width: 640px;
            margin: 40px auto;
            text-align: center;
        }
        .btn-toolbar-simple {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .text-muted { color: #adb5bd !important; }
        @@media (max-width: 991.98px) {
            .admin-wrapper { flex-direction: column; }
            .admin-sidebar {
                width: 100%;
                height: auto;
                position: static;
                top: auto;
                border-right: none;
                border-bottom: 2px solid #415a77;
            }
            .admin-content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
    <nav class="navbar admin-topbar navbar-dark px-4 py-2">
        <a class="navbar-brand fw-bold fs-5" asp-controller="AdminProducts" asp-action="Index">
            <i class="bi bi-shield-lock-fill text-info me-2"></i>
            WebShop <span class="text-info">Admin</span>
        </a>
        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small me-2">Панель администратора</span>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-info btn-sm rounded-pill px-3">
                <i class="bi bi-shop me-1"></i>На сайт
            </a>
        </div>
    </nav>

    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="sidebar-section">Сущности WebShopDB</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminProducts" ? "active" : "")"
               asp-controller="AdminProducts" asp-action="Index">
                <i class="bi bi-box-seam-fill"></i> Товары
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCategories" ? "active" : "")"
               asp-controller="AdminCategories" asp-action="Index">
                <i class="bi bi-tags-fill"></i> Категории
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCartItems" ? "active" : "")"
               asp-controller="AdminCartItems" asp-action="Index">
                <i class="bi bi-cart3"></i> Элементы корзины
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminCarts" ? "active" : "")"
               asp-controller="AdminCarts" asp-action="Index">
                <i class="bi bi-bag"></i> Корзины
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminOrders" ? "active" : "")"
               asp-controller="AdminOrders" asp-action="Index">
                <i class="bi bi-receipt"></i> Заказы
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminOrderItems" ? "active" : "")"
               asp-controller="AdminOrderItems" asp-action="Index">
                <i class="bi bi-list-check"></i> Позиции заказов
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUsers" ? "active" : "")"
               asp-controller="AdminUsers" asp-action="Index">
                <i class="bi bi-people"></i> Пользователи
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminRoles" ? "active" : "")"
               asp-controller="AdminRoles" asp-action="Index">
                <i class="bi bi-person-badge"></i> Роли
            </a>
        </aside>

        <main class="admin-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.alert').forEach(function (el) {
                setTimeout(function () {
                    bootstrap.Alert.getOrCreateInstance(el)?.close();
                }, 4500);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
